<!--
    Head of the email.  
    Define CSS classes and styles
-->
<mj-title>Lesli</mj-title>

<mj-attributes>
        <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
        <mj-body width="600px" background-color="#F8FAFC" />
        <mj-section padding="0px" />
        <mj-column padding="0px" />

        <mj-class
            name="lesli.header"
            padding="48px 24px 28px"
        />
        <mj-class
            name="lesli.card"
            background-color="#FFFFFF"
            border="1px solid #E5EAF0"
            border-radius="16px"
            padding="44px 48px"
        />
        <mj-class
            name="lesli.title"
            align="center"
            color="#1F2933"
            font-size="28px"
            font-weight="700"
            line-height="1.25"
            padding="0px 0px 16px"
        />
        <mj-class
            name="lesli.greeting"
            align="center"
            color="#34404C"
            font-size="18px"
            font-weight="600"
            line-height="1.45"
            padding="0px 0px 16px"
        />
        <mj-class
            name="lesli.text"
            color="#4B5663"
            font-size="16px"
            line-height="1.6"
            padding="0px 0px 16px"
        />
        <mj-class
            name="lesli.text-center"
            align="center"
        />
        <mj-class
            name="lesli.note"
            align="center"
            container-background-color="#F2F7FF"
            border-radius="8px"
            color="#34404C"
            font-size="14px"
            line-height="1.5"
            padding="14px 16px"
        />
        <mj-class
            name="lesli.button-primary"
            background-color="#276AD6"
            border-radius="8px"
            color="#FFFFFF"
            font-size="16px"
            font-weight="600"
            inner-padding="14px 24px"
            padding="8px 0px 24px"
        />
        <mj-class
            name="lesli.footer-heading"
            align="center"
            color="#34404C"
            font-size="14px"
            font-weight="600"
            line-height="1.5"
            padding="0px 0px 12px"
        />
        <mj-class
            name="lesli.footer-text"
            align="center"
            color="#667383"
            font-size="12px"
            line-height="1.5"
            padding="0px"
        />
        <mj-class
            name="lesli.footer-divider"
            border-color="#C7D0DA"
            border-width="1px"
            padding="0px 0px 18px"
            width="64px"
        />
</mj-attributes>

<mj-style>
    a {
        color: #276AD6;
    }

    @media only screen and (max-width: 480px) {
        .lesli-card > table > tbody > tr > td {
            padding: 32px 24px !important;
        }

        .lesli-header > table > tbody > tr > td {
            padding-top: 32px !important;
        }
    }
</mj-style>
