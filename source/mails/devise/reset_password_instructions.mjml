<mjml>
    <mj-head>
        <mj-include path="head.mjml" />
        <mj-preview>Use this secure link to reset your Lesli password.</mj-preview>
    </mj-head>
    <mj-body>

        <!-- Email header -->
        <mj-include path="header.mjml" />

        <!-- Email content -->
        <mj-section mj-class="lesli.card" css-class="lesli-card">
            <mj-column>

                <mj-text mj-class="lesli.title">
                    <h1 style="font: inherit; margin: 0;">Reset your password</h1>
                </mj-text>

                <mj-text mj-class="lesli.greeting">
                    Hello <%= @params[:full_name] %>
                </mj-text>

                <mj-text mj-class="lesli.text">
                    We've received a request to reset your password.
                </mj-text>

                <mj-text mj-class="lesli.text">
                    If you didn't make the request, please ignore this message. Otherwise, you can reset your password using this link:
                </mj-text>

                <mj-button mj-class="lesli.button-primary" href="<%= @params[:url] %>">
                    Reset my password
                </mj-button>

                <mj-text mj-class="lesli.note">
                    Please keep in mind that this link is valid for 6 hours.
                </mj-text>

            </mj-column>
        </mj-section>

        <!-- Email footer -->
        <mj-include path="footer.mjml" />
    </mj-body>
</mjml>
